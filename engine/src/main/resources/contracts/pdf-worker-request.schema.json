{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koldera-core.invalid/pdf-worker-request.v1.json",
  "title": "PdfWorkerRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "jobId", "inputPath", "outputDirectory", "mode", "profile"],
  "properties": {
    "specVersion": {"const": "1.0"},
    "jobId": {"type": "string", "format": "uuid"},
    "inputPath": {"const": "/work/in/document.pdf"},
    "outputDirectory": {"const": "/work/out"},
    "mode": {"enum": ["analyze", "fix"]},
    "profile": {"const": "ua1"},
    "explicitLanguage": {"type": ["string", "null"], "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
    "explicitTitle": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "sourceFileName": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "origin": {"enum": ["upload", "html_generated", "document_generated"], "description": "document_generated: a Typst-rendered structured document; in fix only its renderer-written PDF/UA identifier is withdrawn, nothing is repaired."},
    "declarePdfUa": {"type": "boolean", "description": "Opt-in: write pdfuaid:part=1 in fix mode. Honoured only with humanReviewAcknowledged true, no engine-made structure, no figure auto-marked as artifact and a clean final validation."},
    "humanReviewAcknowledged": {"type": "boolean", "description": "The caller confirms a person reviewed the document; required for declarePdfUa."},
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxBytes": {"type": "integer", "minimum": 1},
        "maxPages": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
