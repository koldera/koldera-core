{
  "title": "Quarterly Report, Example Co.",
  "language": "en",
  "page": { "size": "A4", "orientation": "portrait", "margins": "25mm" },
  "theme": { "font": "Noto Serif", "fontSize": 11, "accent": "#8a1c1c" },
  "header": [{ "type": "image", "file": "logo.png", "decorative": true }],
