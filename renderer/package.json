{
  "name": "@koldera/html-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated static-HTML-to-tagged-PDF render worker (Playwright + Chromium, no network, no scripts)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "koldera-html-renderer": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "playwright": "1.63.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/pngjs": "^6.0.5",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
