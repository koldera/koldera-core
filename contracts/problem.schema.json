{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koldera-core.invalid/problem.v1.json",
  "title": "API Problem Details",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "title",
    "status",
    "code"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri-reference"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "enum": [
        "ARTIFACT_EXPIRED",
        "CHECKSUM_MISMATCH",
        "FILE_IMAGE_NOT_ALLOWED",
        "FILE_TOO_LARGE",
        "FORBIDDEN",
        "HOST_NOT_ALLOWED",
        "IDEMPOTENCY_KEY_REUSED",
        "IMAGE_UPLOAD_INVALID",
        "INSUFFICIENT_SCOPE",
        "INVALID_JSON",
        "NOT_FOUND",
        "ORDER_FIX_UNSUPPORTED",
        "QUEUE_FULL",
        "SESSION_JOB_LIMIT",
        "SESSION_UPLOAD_LIMIT",
        "SIGNATURE_INVALID",
        "SIZE_MISMATCH",
        "STALE_READING_ORDER_SNAPSHOT",
        "UNAUTHORIZED",
        "UNSUPPORTED_INPUT",
        "UNSUPPORTED_MEDIA_TYPE",
        "UPLOAD_ALREADY_COMPLETED",
        "UPLOAD_CONFLICT",
        "UPLOAD_EXPIRED",
        "UPLOAD_INCOMPLETE",
        "UPLOAD_NOT_FOUND",
        "VALIDATION_ERROR"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "code",
          "message"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
